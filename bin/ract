#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Console\Kernel;
use Ract\Application;

$rootPath = dirname(__DIR__);

/** @var Application $app */
$app = require $rootPath . DIRECTORY_SEPARATOR . 'bootstrap' . DIRECTORY_SEPARATOR . 'app.php';
$kernel = new Kernel($app);

exit($kernel->handle($argv));
